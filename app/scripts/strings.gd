static func setup() -> void:
	var wanted := OS.get_environment("ARMADA_PORTS_LANG")
	if wanted == "":
		wanted = OS.get_locale_language()
	lang = wanted if T.has(wanted) else "en"


static func t(key: String, args: Variant = null) -> String:
	var table: Dictionary = T[lang]
	var s: String = table.get(key, T["en"].get(key, key))
	if args == null:
		return s
	return s % args


## A text from the catalog given in several languages ({"en": ..., "it": ...}).
static func pick(d: Variant) -> String:
	if d is Dictionary:
		return str(d.get(lang, d.get("en", "")))
	return str(d) if d != null else ""
